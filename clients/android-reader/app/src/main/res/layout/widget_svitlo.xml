<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ϟ  Світло" android:maxLines="1" android:ellipsize="end" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/widget_ink"/>
   <TextView android:id="@+id/widget_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_muted"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_weather" android:layout_width="68dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end" android:paddingStart="6dp" android:contentDescription="Відкрити прогноз погоди">
   <TextView android:id="@+id/weather_now" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:textColor="@color/widget_ink"/>
   <TextView android:id="@+id/weather_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textSize="10sp" android:maxLines="2" android:textColor="@color/widget_muted"/>
  </LinearLayout>
 </LinearLayout>
 <TextView android:id="@+id/widget_headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_muted"/>
 <TextView android:id="@+id/widget_range" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_ink"/>
 <TextView android:id="@+id/widget_kind" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="1" android:textColor="@color/widget_muted"/>
 <ImageView android:id="@+id/widget_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="35dp" android:scaleType="fitCenter" android:contentDescription="Графік на сьогодні з кроком 5 хвилин. Натисніть, щоб переглянути точні часи."/>
 <ImageView android:id="@+id/widget_tomorrow" android:clickable="true" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="35dp" android:scaleType="fitCenter" android:contentDescription="Графік на завтра з кроком 5 хвилин."/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical|end" android:layout_marginTop="3dp">
  <TextView android:id="@+id/widget_legend" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="● ГПВ  ● Планові  ● Аварійні  ▨ невідомо" android:textSize="9sp" android:maxLines="2" android:textColor="@color/widget_muted"/>
  <TextView android:id="@+id/widget_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="2dp" android:text="↻ Оновити" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:contentDescription="Оновити графіки та погоду"/>
 </LinearLayout>
</LinearLayout>





