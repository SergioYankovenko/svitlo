<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/widget_dark_bg">
 <LinearLayout android:id="@+id/detail_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="true" android:gravity="center_vertical">
  <TextView android:includeFontPadding="false" android:minHeight="0dp" android:gravity="center_vertical" android:id="@+id/detail_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Мої адреси" android:drawableStart="@drawable/ic_widget_home" android:drawablePadding="8dp" android:textSize="20sp" android:maxLines="1" android:ellipsize="end" android:textColor="#F0F3E8"/>
  <TextView android:includeFontPadding="false" android:minHeight="0dp" android:id="@+id/detail_weather" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:gravity="end|center_vertical" android:text="—°" android:textSize="24sp" android:textColor="#F0F3E8"/>
 </LinearLayout>
 <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="1dp" android:layout_marginBottom="1dp" android:background="#43594C" android:importantForAccessibility="no"/>
 <FrameLayout android:id="@+id/detail_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:id="@+id/detail_rows" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"/>
  <ListView android:id="@+id/detail_list" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:divider="@null" android:scrollbars="none" android:cacheColorHint="#00000000"/>
  <TextView android:id="@+id/detail_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Додайте адресу" android:textColor="#F0F3E8" android:textSize="14sp" android:visibility="gone"/>
 </FrameLayout>
 <ImageView android:id="@+id/detail_axis" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:scaleType="fitXY" android:importantForAccessibility="no"/>
 <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="1dp" android:layout_marginBottom="1dp" android:background="#43594C" android:importantForAccessibility="no"/>
 <LinearLayout android:id="@+id/detail_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
 <LinearLayout android:id="@+id/detail_footer_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/detail_legend" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="■ Світло є   ■ Світла немає" android:textSize="12sp" android:textColor="#BCC9BD"/>
  <TextView android:id="@+id/detail_refresh" android:layout_width="48dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="6dp" android:gravity="center" android:text="↻ Оновити" android:textSize="12sp" android:textColor="#C1D99A"/>
  <LinearLayout android:id="@+id/detail_pager" android:layout_width="wrap_content" android:layout_height="48dp" android:orientation="horizontal" android:visibility="gone">
   <ImageButton android:id="@+id/detail_previous" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:background="@android:color/transparent" android:src="@drawable/ic_widget_previous" android:contentDescription="Попередні адреси"/>
   <ImageButton android:id="@+id/detail_next" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:background="@android:color/transparent" android:src="@drawable/ic_widget_next" android:contentDescription="Наступні адреси"/>
  </LinearLayout>
 </LinearLayout>
 <TextView android:id="@+id/detail_legend_stacked" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#BCC9BD" android:visibility="gone"/>
 <TextView android:id="@+id/detail_refresh_stacked" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="end|center_vertical" android:textSize="12sp" android:textColor="#C1D99A" android:visibility="gone"/>
 </LinearLayout>
</LinearLayout>
