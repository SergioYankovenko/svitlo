{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"urn:svitlo:adapter:resolution:1",
 "type":"object",
 "required":["state","complete","checkedAt","lines"],
 "properties":{
  "state":{"enum":["resolved","excluded","ambiguous","unknown"]},
  "complete":{"type":"boolean"},
  "checkedAt":{"type":"integer","minimum":0,"maximum":9007199254740991},
  "lines":{"type":"array","maxItems":32,"items":{
   "type":"object","required":["key","label"],
   "properties":{
    "key":{"type":"string","minLength":1,"maxLength":120,"pattern":"^[^\\u0000-\\u001f]+$"},
    "label":{"type":"string","maxLength":500},
    "groupCode":{"type":["string","null"],"maxLength":80},
    "provenance":{"type":"object"}
   }
  }},
  "provenance":{"type":"object"}
 }
}
