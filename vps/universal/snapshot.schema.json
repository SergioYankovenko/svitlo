{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"urn:svitlo:universal:snapshot:1",
 "title":"Svitlo universal snapshot v1",
 "type":"object",
 "required":["schemaVersion","revision","addressId","operatorId","timeZone","coverage","resolution","lines","notices","provenance","checkedAt","sourceUpdatedAt","freshUntil","refreshAfter","supportState"],
 "properties":{
  "schemaVersion":{"const":1},"revision":{"type":"string","minLength":1},"addressId":{"type":"string"},"operatorId":{"type":"string"},"timeZone":{"const":"Europe/Kyiv"},
  "supportState":{"enum":["available","degraded","disabled","unsupported"]},
  "coverage":{"type":"object","required":["fromDate","toDate"],"properties":{"fromDate":{"type":"string","format":"date"},"toDate":{"type":"string","format":"date"}}},
  "resolution":{"type":"object","required":["state","complete"],"properties":{"state":{"enum":["resolved","ambiguous","excluded","unknown"]},"complete":{"type":"boolean"}}},
  "checkedAt":{"type":"number","minimum":0},"sourceUpdatedAt":{"type":["number","null"],"minimum":0},"freshUntil":{"type":"number","minimum":0},"refreshAfter":{"type":"number","minimum":0},
  "notices":{"type":"array"},"provenance":{"type":"array"},"synthetic":{"type":"boolean"},
  "lines":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/line"}}
 },
 "$defs":{
  "interval":{"type":"object","required":["start","end"],"properties":{"start":{"type":"number","minimum":0},"end":{"type":["number","null"],"minimum":0}}},
  "day":{"type":"object","required":["date","state","intervals"],"properties":{"date":{"type":"string","format":"date"},"state":{"enum":["published","not_published","excluded","unknown","stale","suspended","unsupported"]},"intervals":{"type":"array","maxItems":2000,"items":{"$ref":"#/$defs/interval"}}}},
  "category":{"type":"object","required":["checkedAt","sourceUpdatedAt","freshUntil","days"],"properties":{"checkedAt":{"type":"number","minimum":0},"sourceUpdatedAt":{"type":["number","null"],"minimum":0},"freshUntil":{"type":"number","minimum":0},"days":{"type":"array","maxItems":14,"items":{"$ref":"#/$defs/day"}}}},
  "line":{"type":"object","required":["id","label","groupCode","supportedCategories","categories"],"properties":{"id":{"type":"string"},"label":{"type":"string"},"groupCode":{"type":["string","null"],"maxLength":80},"supportedCategories":{"type":"array","items":{"enum":["hourly","planned","unplanned","emergency"]}},"categories":{"type":"object","additionalProperties":{"$ref":"#/$defs/category"}}}}
 }
}
