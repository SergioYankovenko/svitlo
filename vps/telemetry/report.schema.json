{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:svitlo:diagnostic-report:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "client", "occurredAt", "stage", "code", "events"],
  "properties": {
    "schemaVersion": {"const": 1},
    "reportId": {"type": "string", "format": "uuid", "maxLength": 36},
    "client": {"type": "object", "additionalProperties": false, "required": ["target", "version"], "properties": {"target": {"enum": ["android", "pwa"]}, "version": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[A-Za-z0-9._-]+$"}}},
    "occurredAt": {"type": "string", "format": "date-time", "maxLength": 30},
    "stage": {"enum": ["city", "street", "house", "submit"]},
    "code": {"enum": ["empty", "temporary", "timeout", "offline"]},
    "httpStatus": {"type": "integer", "minimum": 100, "maximum": 599},
    "correlationId": {"type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"},
    "events": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["name", "code"], "properties": {"name": {"enum": ["lookup_started", "lookup_failed", "retry_requested"]}, "code": {"enum": ["empty", "temporary", "timeout", "offline"]}}}}
  }
}
